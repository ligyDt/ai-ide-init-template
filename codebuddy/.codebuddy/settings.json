{
  "language": "Chinese",
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(npm publish*)",
      "Bash(pnpm publish*)",
      "Bash(terraform apply*)",
      "Bash(terraform destroy*)",
      "Bash(kubectl apply*)",
      "Bash(kubectl delete*)",
      "Bash(docker push*)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CODEBUDDY_PROJECT_DIR/.codebuddy/hooks/guard_secrets.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Bash|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CODEBUDDY_PROJECT_DIR/.codebuddy/hooks/guard_secrets.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
